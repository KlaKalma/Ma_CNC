<?xml version="1.0" encoding="utf-8"?>
<!--
  Topologie EtherCAT — vérifiée avec 'ethercat slaves' le 2026-06-17
  dcConf (DC sync) : UNIQUEMENT pour les drives LC10E
  Modules EL Beckhoff : types natifs, pas de dcConf, pas de configPdos

  Topologie mise à jour le 2026-07-07 : EL2088 inséré en pos.6 → tous les
  slaves en aval décalés de +1 (EL4002, EL1008, et les 3 drives LC10E).

  Pos 0  : EK1100  Bus coupler           (pas de config PDO)
  Pos 1  : EL2024 #1  → type="EL2024"   pins : lcec.0.1.dout-0..3
  Pos 2  : EL2024 #2  (à configurer)
  Pos 3  : EL2024 #3  (à configurer)
  Pos 4  : EL2008 #1  → type="EL2008"   pins : lcec.0.4.dout-0..7  (SPARE — VFD déplacé sur EL2088)
  Pos 5  : EL2008 #2  (à configurer)
  Pos 6  : EL2088     → type="EL2088"   pins : lcec.0.6.dout-0..7  (NPN/ground — commandes VFD X1-X8)
  Pos 7  : EL4002     → type="EL4002"   pins : lcec.0.7.aout-0/1-{value,enable,scale,...}
  Pos 8  : EL1008 #1  → type="EL1008"   pins : lcec.0.8.din-0..7
  Pos 9  : EL1008 #2  (à configurer)
  Pos 10 : EL1008 #3  (à configurer)
  Pos 11 : LC10E X    CIA402 CSV          Joint 0
  Pos 12 : LC10E Y    CIA402 CSV          Joint 1
  Pos 13 : LC10E Z    CIA402 CSV          Joint 2
-->
<masters>
  <master idx="0" appTimePeriod="1000000" refClockSyncCycles="5">

    <!-- pos.0 : EK1100 Bus Coupler — aucune config PDO requise -->

    <!-- ── EL2024 #1 — pos.1 — Freins XYZ ───────────────────────── -->
    <slave idx="1" type="EL2024"/>

    <!-- pos.2 : EL2024 #2  (à configurer) -->
    <!-- pos.3 : EL2024 #3  (à configurer) -->

    <!-- ── EL2008 #1 — pos.4 — SPARE (ancien module VFD) ────────── -->
    <!-- Les commandes VFD ont été déplacées sur l'EL2088 (pos.6) le      -->
    <!-- 2026-07-07 : les entrées NPN du FC300 (actives à 0V) sont        -->
    <!-- incompatibles avec l'EL2008 sourcing/PNP (+24V). Ce module reste -->
    <!-- disponible comme 8 sorties PNP libres : lcec.0.4.dout-0..7.      -->
    <slave idx="4" type="EL2008"/>

    <!-- pos.5 : EL2008 #2  (à configurer) -->

    <!-- ── EL2088 — pos.6 — Commandes VFD X1-X8 (NPN/ground) ─────── -->
    <!-- Installé le 2026-07-07. Ground switching / NPN : dout-N ON tire  -->
    <!-- la borne à 0V → active l'entrée NPN X_n du VFD FC300. Drop-in    -->
    <!-- électrique de l'EL2008 : mêmes pins lcec.0.6.dout-0..7, AUCUNE   -->
    <!-- inversion HAL (logique dout ON = fonction active).               -->
    <!-- ⚠️ Câblage requis : 0V de l'EL2088 relié au COM du VFD.          -->
    <!-- Voir CLAUDE.md section "NPN vs PNP".                             -->
    <slave idx="6" type="EL2088"/>

    <!-- ── EL4002 — pos.7 — Consigne vitesse AVI ─────────────────── -->
    <!-- aout-N-value : float [-1..1] × scale → tension sortie ±10V  -->
    <!-- aout-N-scale : défaut 1.0  (value=1.0 → +10V)               -->
    <slave idx="7" type="EL4002"/>

    <!-- ── EL1008 #1 — pos.8 — Retours VFD Y1/Y2 ────────────────── -->
    <slave idx="8" type="EL1008"/>

    <!-- pos.9  : EL1008 #2  (à configurer — sécurités) -->
    <!-- pos.10 : EL1008 #3  (à configurer) -->

    <!-- ── LC10E X — pos.11 — Joint 0 ───────────────────────────── -->
    <slave idx="11" type="generic" vid="00000766" pid="00000402" configPdos="true">
      <dcConf assignActivate="300" sync0Cycle="*1" sync0Shift="0"/>
      <syncManager idx="2" dir="out">
        <pdo idx="1600">
          <pdoEntry idx="6040" subIdx="00" bitLen="16" halPin="cia-controlword"  halType="u32"/>
          <pdoEntry idx="6060" subIdx="00" bitLen="8"  halPin="opmode"           halType="s32"/>
          <pdoEntry idx="607A" subIdx="00" bitLen="32" halPin="target-position"  halType="s32"/>
          <pdoEntry idx="60FF" subIdx="00" bitLen="32" halPin="target-velocity"  halType="s32"/>
        </pdo>
      </syncManager>
      <syncManager idx="3" dir="in">
        <pdo idx="1a00">
          <pdoEntry idx="6041" subIdx="00" bitLen="16" halPin="cia-statusword"   halType="u32"/>
          <pdoEntry idx="6061" subIdx="00" bitLen="8"  halPin="opmode-display"   halType="s32"/>
          <pdoEntry idx="6064" subIdx="00" bitLen="32" halPin="actual-position"  halType="s32"/>
          <pdoEntry idx="606C" subIdx="00" bitLen="32" halPin="actual-velocity"  halType="s32"/>
          <!-- 0x60FD DI state : fins de course X lues sur le drive (capteurs NC). -->
          <!-- bit0=N-OT(-) bit1=P-OT(+) bit2=origine ; bits20-24=DI0..DI4 bruts.  -->
          <pdoEntry idx="60FD" subIdx="00" bitLen="32" halType="complex">
            <complexEntry bitLen="1"  halPin="din-not"  halType="bit"/>   <!-- bit0  : N-OT (limite -) -->
            <complexEntry bitLen="1"  halPin="din-pot"  halType="bit"/>   <!-- bit1  : P-OT (limite +) -->
            <complexEntry bitLen="1"  halPin="din-home" halType="bit"/>   <!-- bit2  : origine (non cablee) -->
            <complexEntry bitLen="17"/>                                   <!-- bits 3..19 : padding -->
            <complexEntry bitLen="1"  halPin="din-di0"  halType="bit"/>   <!-- bit20 : DI0 brut (debug) -->
            <complexEntry bitLen="1"  halPin="din-di1"  halType="bit"/>   <!-- bit21 : DI1 brut (debug) -->
          </pdoEntry>
        </pdo>
      </syncManager>
    </slave>

    <!-- ── LC10E Y — pos.12 — Joint 1 ───────────────────────────── -->
    <slave idx="12" type="generic" vid="00000766" pid="00000402" configPdos="true">
      <dcConf assignActivate="300" sync0Cycle="*1" sync0Shift="0"/>
      <syncManager idx="2" dir="out">
        <pdo idx="1600">
          <pdoEntry idx="6040" subIdx="00" bitLen="16" halPin="cia-controlword"  halType="u32"/>
          <pdoEntry idx="6060" subIdx="00" bitLen="8"  halPin="opmode"           halType="s32"/>
          <pdoEntry idx="607A" subIdx="00" bitLen="32" halPin="target-position"  halType="s32"/>
          <pdoEntry idx="60FF" subIdx="00" bitLen="32" halPin="target-velocity"  halType="s32"/>
        </pdo>
      </syncManager>
      <syncManager idx="3" dir="in">
        <pdo idx="1a00">
          <pdoEntry idx="6041" subIdx="00" bitLen="16" halPin="cia-statusword"   halType="u32"/>
          <pdoEntry idx="6061" subIdx="00" bitLen="8"  halPin="opmode-display"   halType="s32"/>
          <pdoEntry idx="6064" subIdx="00" bitLen="32" halPin="actual-position"  halType="s32"/>
          <pdoEntry idx="606C" subIdx="00" bitLen="32" halPin="actual-velocity"  halType="s32"/>
        </pdo>
      </syncManager>
    </slave>

    <!-- ── LC10E Z — pos.13 — Joint 2 ───────────────────────────── -->
    <slave idx="13" type="generic" vid="00000766" pid="00000402" configPdos="true">
      <dcConf assignActivate="300" sync0Cycle="*1" sync0Shift="0"/>
      <syncManager idx="2" dir="out">
        <pdo idx="1600">
          <pdoEntry idx="6040" subIdx="00" bitLen="16" halPin="cia-controlword"  halType="u32"/>
          <pdoEntry idx="6060" subIdx="00" bitLen="8"  halPin="opmode"           halType="s32"/>
          <pdoEntry idx="607A" subIdx="00" bitLen="32" halPin="target-position"  halType="s32"/>
          <pdoEntry idx="60FF" subIdx="00" bitLen="32" halPin="target-velocity"  halType="s32"/>
        </pdo>
      </syncManager>
      <syncManager idx="3" dir="in">
        <pdo idx="1a00">
          <pdoEntry idx="6041" subIdx="00" bitLen="16" halPin="cia-statusword"   halType="u32"/>
          <pdoEntry idx="6061" subIdx="00" bitLen="8"  halPin="opmode-display"   halType="s32"/>
          <pdoEntry idx="6064" subIdx="00" bitLen="32" halPin="actual-position"  halType="s32"/>
          <pdoEntry idx="606C" subIdx="00" bitLen="32" halPin="actual-velocity"  halType="s32"/>
        </pdo>
      </syncManager>
    </slave>

  </master>
</masters>
